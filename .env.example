# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Azure Production Deployment Configurations ---
# Target PostgreSQL database URL (e.g. postgresql://user:password@hostname:5432/dbname)
# When running via docker-compose, this is built automatically from the
# POSTGRES_* values below - you don't need to set it separately in that case.
DATABASE_URL="postgresql://honeyuser:honeypassword@localhost:5432/honeydb"

# --- Postgres credentials used by docker-compose.yml ---
# These replace the credentials that used to be hardcoded directly in the compose file.
POSTGRES_DB="honeydb"
POSTGRES_USER="honeyuser"
POSTGRES_PASSWORD="change-me-to-a-real-password"

# Azure Maps geolocation endpoint integration key (Optional if Leaflet is standard)
AZURE_MAPS_KEY="YOUR_AZURE_MAPS_SUBSCRIPTION_KEY"

# Bearer tokens required (Authorization: Bearer <token>) to call the external
# ingestion endpoints: POST /api/wazuh/webhook and POST /api/prowler/upload.
# These endpoints reject every request if their token is not set (fail-closed),
# so both must be set before wiring up a real Wazuh manager or Prowler CI job.
# Configure your Wazuh integration script and Prowler CI job with the matching value.
WAZUH_WEBHOOK_TOKEN="generate-a-random-secret-for-wazuh"
PROWLER_WEBHOOK_TOKEN="generate-a-random-secret-for-prowler"

# Session cryptographic secret keys
SECRET_KEY="generate-a-secure-secret-key-string-here"

# Permitted inbound host patterns
ALLOWED_HOSTS="*"

