# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Azure Production Deployment Configurations ---
# Target PostgreSQL database URL (e.g. postgresql://user:password@hostname:5432/dbname)
# When running via docker-compose, this is built automatically from the
# POSTGRES_* values below - you don't need to set it separately in that case.
DATABASE_URL="postgresql://honeyuser:honeypassword@localhost:5432/honeydb"

# --- Postgres credentials used by docker-compose.yml ---
# These replace the credentials that used to be hardcoded directly in the compose file.
POSTGRES_DB="honeydb"
POSTGRES_USER="honeyuser"
POSTGRES_PASSWORD="change-me-to-a-real-password"

# Azure Maps geolocation endpoint integration key (Optional if Leaflet is standard)
AZURE_MAPS_KEY="YOUR_AZURE_MAPS_SUBSCRIPTION_KEY"

# --- Azure Service Principal, used by the real on-demand Prowler scan ---
# Triggered from the dashboard's "Simulate Cloud Misconfiguration" button via
# POST /api/prowler/scan. Interactive az-cli/browser login isn't available from
# a server-side button click, so a Service Principal is required for this.
# Create one (Reader is enough for Prowler's read-only checks):
#   az ad sp create-for-rbac --name hybrid-siem-prowler --role Reader \
#     --scopes /subscriptions/<your-subscription-id>
# That command prints appId (-> AZURE_CLIENT_ID), password (-> AZURE_CLIENT_SECRET),
# and tenant (-> AZURE_TENANT_ID).
AZURE_CLIENT_ID=""
AZURE_TENANT_ID=""
AZURE_CLIENT_SECRET=""

# Bearer tokens required (Authorization: Bearer <token>) to call the external
# ingestion endpoints: POST /api/wazuh/webhook and POST /api/prowler/upload.
# These endpoints reject every request if their token is not set (fail-closed),
# so both must be set before wiring up a real Wazuh manager or Prowler CI job.
# Configure your Wazuh integration script and Prowler CI job with the matching value.
WAZUH_WEBHOOK_TOKEN="generate-a-random-secret-for-wazuh"
PROWLER_WEBHOOK_TOKEN="generate-a-random-secret-for-prowler"

# --- Wazuh Manager API, used by GET /api/wazuh/agent-status ---
# Separate from the webhook token above: this is the dashboard calling OUT to
# the Wazuh Manager's own REST API (default port 55000) to show the real
# connection state of the monitored-host agent, instead of a hardcoded badge.
# WAZUH_API_URL: e.g. https://192.168.122.71:55000 (the Wazuh manager host, NOT the agent)
# WAZUH_API_USER / WAZUH_API_PASSWORD: a Wazuh API user (check the manager's
#   /var/ossec/api/configuration/api.yaml, or create one - the Wazuh dashboard's
#   own 'wazuh-wui' account also works if you have its password).
# WAZUH_AGENT_ID: the agent to report on (check with `/var/ossec/bin/agent_control -l`
#   on the manager, or the Wazuh dashboard's Agents page). Defaults to "001".
# Left unset, the dashboard shows an honest "NOT CONFIGURED" state instead of
# guessing. Uses a self-signed cert by default, like a typical Wazuh install.
WAZUH_API_URL=""
WAZUH_API_USER=""
WAZUH_API_PASSWORD=""
WAZUH_AGENT_ID="001"

# Session cryptographic secret keys
SECRET_KEY="generate-a-secure-secret-key-string-here"

# Permitted inbound host patterns
ALLOWED_HOSTS="*"

